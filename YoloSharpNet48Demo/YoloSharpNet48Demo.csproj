<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>YoloSharpNet48Demo</RootNamespace>
    <AssemblyName>YoloSharpNet48Demo</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- net48 引 netstandard2.0 库必须开启绑定重定向 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- YoloSharp 本体：项目引用（解决方案内），SetTargetFramework 强制取 netstandard2.0 构建喂给 net48 -->
    <ProjectReference Include="..\YoloSharp\YoloSharp.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <!-- TorchSharp 全家（netstandard2.0 目标） -->
    <PackageReference Include="TorchSharp" Version="0.105.2" />
    <PackageReference Include="TorchVision" Version="0.105.2" />
    <!-- libtorch 原生运行时：cuda-12.8（本机驱动591.74/CUDA13.1兼容） -->
    <PackageReference Include="libtorch-cuda-12.8-win-x64" Version="2.7.1" />
    <!-- OpenCvSharp 运行时（net48 有原生目标） -->
    <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    <!-- 统一SkiaSharp版本：YoloSharp经ScottPlot引用3.119，显式钉住避免2.88/3.119混载 -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <!-- [Add 2026-11-10] ONNX导出对拍模式依赖（与YoloSharpDemo的onnxexport入口同功能） -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

</Project>
